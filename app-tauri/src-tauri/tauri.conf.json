{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Susurro",
  "version": "1.2.0",
  "identifier": "com.susurro.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "pill",
        "title": "Susurro Pill",
        "url": "/#pill",
        "width": 360,
        "height": 64,
        "center": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Susurro",
        "url": "/#app",
        "width": 1120,
        "height": 760,
        "visible": true
      },
      {
        "label": "onboarding",
        "title": "Susurro setup",
        "url": "/#onboarding",
        "width": 480,
        "height": 560,
        "visible": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "tooltip": "Susurro — talk-to-text",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/models/tiny.en.bin",
      "resources/models/punct-cnn-bilstm.int8.onnx",
      "resources/models/punct-bpe.vocab",
      "resources/dylib/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/SilesterGold9/susurro/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NzcwNDFBOTU3QjE1MTYKUldRV0ZYdVZHZ1IzbGxyS1dTNzhpcjVRbitFL3FxOGMzcXp4a0czSnU0Rm1rck9kS1g0cTFLaVIK"
    }
  }
}
